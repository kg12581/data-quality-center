# 数据库连接配置示例：复制成 .env 改成真实值（.env 已 gitignore，不会提交到仓库）
#
# 命名规则：DQ_CONN_<连接名>_<字段>
# 可用字段：TYPE / BACKEND / URL / HOST / PORT / DATABASE / SCHEMA / CATALOG / PROJECT /
#          SERVICE / USER / PASSWORD / DRIVER_CLASS / DRIVER_PATH / QUERY_ENGINE / DIALECT
# 规则集里只写连接名：sources: { hive_dw: { conn: dw_hive, table: dim_user } }
#
# 优先级：代码传入的 conns > 进程环境变量 > 这个 .env 文件
# 服务器定时任务可以指定：python 用户数据质量.py --env /opt/conf/prod.env

# ---------------- 大数据：Hive（整串 URL 写法）----------------
DQ_CONN_DW_HIVE_TYPE=hive
DQ_CONN_DW_HIVE_URL=jdbc:hive2://hive-server.example.com:10000/dw
DQ_CONN_DW_HIVE_USER=etl
DQ_CONN_DW_HIVE_PASSWORD=change_me
DQ_CONN_DW_HIVE_DRIVER_PATH=/opt/jdbc/hive-jdbc.jar

# ---------------- Trino / Hudi / Paimon（走 Trino 查湖表，分字段写法）----------------
DQ_CONN_LAKE_TRINO_TYPE=trino
DQ_CONN_LAKE_TRINO_HOST=trino.example.com
DQ_CONN_LAKE_TRINO_PORT=8080
DQ_CONN_LAKE_TRINO_CATALOG=hive
DQ_CONN_LAKE_TRINO_SCHEMA=dw
DQ_CONN_LAKE_TRINO_USER=etl
DQ_CONN_LAKE_TRINO_PASSWORD=change_me
DQ_CONN_LAKE_TRINO_DRIVER_PATH=/opt/jdbc/trino-jdbc.jar

# ---------------- Doris（MySQL 协议，9030，不需要 jar）----------------
DQ_CONN_DORIS_DW_TYPE=doris
DQ_CONN_DORIS_DW_HOST=doris-fe.example.com
DQ_CONN_DORIS_DW_PORT=9030
DQ_CONN_DORIS_DW_DATABASE=dw
DQ_CONN_DORIS_DW_USER=etl
DQ_CONN_DORIS_DW_PASSWORD=change_me

# ---------------- MySQL / PostgreSQL ----------------
DQ_CONN_MYSQL_USERDB_TYPE=mysql
DQ_CONN_MYSQL_USERDB_HOST=mysql.example.com
DQ_CONN_MYSQL_USERDB_PORT=3306
DQ_CONN_MYSQL_USERDB_DATABASE=userdb
DQ_CONN_MYSQL_USERDB_USER=etl
DQ_CONN_MYSQL_USERDB_PASSWORD=change_me

DQ_CONN_PG_DW_TYPE=postgresql
DQ_CONN_PG_DW_HOST=pg.example.com
DQ_CONN_PG_DW_DATABASE=analytics
DQ_CONN_PG_DW_USER=etl
DQ_CONN_PG_DW_PASSWORD=change_me

# ---------------- Oracle（JDBC）----------------
DQ_CONN_ORACLE_ODS_TYPE=oracle
DQ_CONN_ORACLE_ODS_HOST=oracle.example.com
DQ_CONN_ORACLE_ODS_PORT=1521
DQ_CONN_ORACLE_ODS_SERVICE=ORCLPDB1
DQ_CONN_ORACLE_ODS_USER=etl
DQ_CONN_ORACLE_ODS_PASSWORD=change_me
DQ_CONN_ORACLE_ODS_DRIVER_PATH=/opt/jdbc/ojdbc8.jar

# ---------------- ODPS / MaxCompute（JDBC 或 backend=pyodps）----------------
DQ_CONN_ODPS_DW_TYPE=odps
DQ_CONN_ODPS_DW_BACKEND=pyodps
DQ_CONN_ODPS_DW_PROJECT=my_project
DQ_CONN_ODPS_DW_URL=jdbc:odps:https://service.cn-hangzhou.maxcompute.aliyun.com/api
DQ_CONN_ODPS_DW_USER=your_access_id
DQ_CONN_ODPS_DW_PASSWORD=your_access_key

# ---------------- 本地 SQLite（没有集群时用来做联调）----------------
DQ_CONN_LOCAL_DB_TYPE=sqlite
DQ_CONN_LOCAL_DB_URL=sqlite:///data/users.db

# ---------------- 保险行业：阿里云 MaxCompute / ODPS ----------------
# 规则集：testcase/6e49032b-ea6e-4621-8dbc-bf4bfc3a832a.yaml（name: 保险_承保理赔数据质量）
DQ_CONN_ODPS_DW_TYPE=odps
DQ_CONN_ODPS_DW_BACKEND=pyodps                # 用官方 SDK；也可以用 jdbc + odps-jdbc.jar
DQ_CONN_ODPS_DW_PROJECT=ins_ods
DQ_CONN_ODPS_DW_HOST=service.<region>.maxcompute.aliyun.com
DQ_CONN_ODPS_DW_USER=your_access_id
DQ_CONN_ODPS_DW_PASSWORD=your_access_key
# JDBC 方式（backend=jdbc 时）：
# DQ_CONN_ODPS_DW_BACKEND=jdbc
# DQ_CONN_ODPS_DW_URL=jdbc:odps:https://service.<region>.maxcompute.aliyun.com/api?project=ins_ods
# DQ_CONN_ODPS_DW_DRIVER_PATH=/opt/jdbc/odps-jdbc.jar

# ---------------- 制造业：Hive / HiveServer2 ----------------
# 规则集：testcase/4d1c7884-d049-48a4-bd86-17fdbd95f495.yaml（name: 制造业_工单制造数据质量）
DQ_CONN_HIVE_MFG_TYPE=hive
DQ_CONN_HIVE_MFG_HOST=hive-server.example.com
DQ_CONN_HIVE_MFG_PORT=10000
DQ_CONN_HIVE_MFG_DATABASE=ods_mfg
DQ_CONN_HIVE_MFG_USER=etl_user
DQ_CONN_HIVE_MFG_PASSWORD=change_me
DQ_CONN_HIVE_MFG_DRIVER_PATH=/opt/jdbc/hive-jdbc.jar:/opt/jdbc/hadoop-common.jar:/opt/jdbc/libthrift.jar
